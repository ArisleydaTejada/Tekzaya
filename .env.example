# ─────────────────────────────────────────────────────────────
# Tekzaya — variables de entorno
# Copia este archivo como .env y ajusta los valores.
#   cp .env.example .env      (Git Bash)
#   Copy-Item .env.example .env   (PowerShell)
# El archivo .env NUNCA se versiona.
# ─────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────
NODE_ENV=development

# El proceso de la API corre en UTC: las fechas se GUARDAN siempre en UTC (spec §13).
TZ=UTC

# Zona horaria de operación de la empresa. Define cuándo corre el reloj del SLA
# (la jornada de 08:00 a 18:00), y es la misma para todo el equipo aunque alguien
# trabaje desde otro país. Cada persona ve las fechas en el reloj de su propia
# computadora; lo que no cambia es la jornada.
# Solo es el valor inicial: luego se edita en Administración → Configuración.
COMPANY_TIMEZONE=America/La_Paz

# ── API ──────────────────────────────────────────────────────
PORT=4000

# Origen del frontend, para CORS. Vite levanta en 5173.
WEB_ORIGIN=http://localhost:5173

# ── Base de datos ────────────────────────────────────────────
# MongoDB Community instalado en Windows: sin usuario ni contraseña.
MONGODB_URI=mongodb://localhost:27017/tekzaya

# Alternativa sin instalar nada — MongoDB Atlas (plan gratuito M0, spec §10.1).
# Pega aquí la cadena de conexión que da Atlas y añade el nombre de la base:
#   MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/tekzaya?retryWrites=true&w=majority
# Requiere internet, también durante la defensa.

# ── Adjuntos ─────────────────────────────────────────────────
# Directorio en disco donde se guardan los archivos subidos. Queda FUERA de lo
# que sirve el servidor web: solo se descargan por un endpoint que comprueba
# permisos (spec §10.4). Relativo a la raíz del repositorio si no es absoluto.
UPLOAD_DIR=uploads

# ── Autenticación (se usa a partir de la fase F2) ─────────────
# Genera secretos largos y aleatorios, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google Identity Services — consola de Google Cloud
GOOGLE_CLIENT_ID=

# Restringe el login con Google a un dominio corporativo (opcional)
ALLOWED_GOOGLE_DOMAIN=

# ── Inteligencia artificial ──────────────────────────────────
# Clave del plan gratuito de Gemini: https://aistudio.google.com/apikey
# Si se deja vacía, la aplicación funciona igual, sin IA (spec §6.3): el ticket
# se crea con el área elegida a mano y prioridad Media, y las funciones de IA
# ni siquiera aparecen en pantalla.
#
# AVISO del spec §6.1: en el plan gratuito Google puede usar el contenido
# enviado para mejorar sus productos. No mandes datos sensibles reales.
GEMINI_API_KEY=

# Modelo a usar. La variante "lite" de la familia Flash está medida en ~0,7 s por
# sugerencia; las hermanas mayores tardan ~10 s o devuelven 503 por saturación.
#
# Google retira nombres con el tiempo. Si la API responde 404 diciendo que el
# modelo ya no está disponible, el arreglo es cambiar esta línea; para ver cuáles
# acepta tu clave:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=TU_CLAVE"
GEMINI_MODEL=gemini-3.5-flash-lite
